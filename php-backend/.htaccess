# Verhindert direkten Zugriff auf Config, Schema und sonstige interne Dateien.
# Nur /public und /api sollen von außen erreichbar sein.
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>
Options -Indexes

# Wer die nackte Domain aufruft, landet direkt auf der Lead-Ansicht statt
# einem 403 (kein Index in diesem Ordner).
RedirectMatch 302 ^/$ /public/lead.html
